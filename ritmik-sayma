        <div class="flex items-center justify-between border-b border-slate-700 pb-2.5">
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-rose-400 inline-block"></span>
            <h2 class="text-lg font-black text-rose-300">KIRMIZI TAKIM TRENİ</h2>
          </div>
          <span id="duelScoreRight" class="px-3 py-1 rounded-xl bg-rose-500/20 border border-rose-400/40 text-rose-200 font-black text-base">
            Puan: 0
          </span>
        </div>

        <!-- Tren Vagonları (Soru) -->
        <div class="my-4 bg-slate-900/90 rounded-2xl p-4 border border-slate-700">
          <p id="duelRuleRight" class="text-xs font-bold text-rose-300 uppercase tracking-wider text-center mb-2">
            6'şar İleriye Ritmik Sayma
          </p>
          <div id="duelTrainRight" class="flex flex-wrap items-center justify-center gap-2">
            <!-- JS ile vagonlar -->
          </div>
          <p id="duelFeedbackRight" class="text-center text-sm font-bold text-slate-300 mt-3 h-5">
            Eksik vagonu aşağıdan seç!
          </p>
        </div>

        <!-- Alt Dokunmatik Seçenekler (Sağ) -->
        <div id="duelOptionsRight" class="grid grid-cols-2 gap-3 mt-auto">
          <!-- 4 Büyük Buton -->
        </div>
      </div>

    </section>

  </main>

  <!-- ÖĞRETMEN AYAR MODALI -->
  <div id="settingsModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-slate-900 border-2 border-slate-700 rounded-2xl max-w-lg w-full p-5 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
        <h3 class="text-lg font-black text-white">⚙️ Öğretmen Ritmik Sayma Ayarları</h3>
        <button id="closeSettingsBtn" type="button" class="smartboard-btn px-3 py-1 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-bold">
          ✕ Kapat
        </button>
      </div>

      <div class="space-y-4">
        <!-- Sayma yönü -->
        <div>
          <label class="block text-xs font-bold uppercase text-slate-400 mb-2">Sayma Yönü</label>
          <div class="grid grid-cols-2 gap-2">
            <button id="dirForwardBtn" type="button" class="smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-emerald-500 text-slate-950">
              ➡️ İleriye Ritmik Sayma
            </button>
            <button id="dirBackwardBtn" type="button" class="smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700">
              ⬅️ Geriye Ritmik Sayma
            </button>
          </div>
        </div>

        <!-- Başlangıç Noktası -->
        <div>
          <label class="block text-xs font-bold uppercase text-slate-400 mb-2">Başlangıç Seviyesi</label>
          <div class="grid grid-cols-2 gap-2">
            <button id="startStandardBtn" type="button" class="smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-amber-400 text-slate-950">
              🎯 Standart Katlar (6, 12, 18...)
            </button>
            <button id="startCustomBtn" type="button" class="smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700">
              🚀 Farklı Sayıdan Başla (Ör. 14, 20, 26...)
            </button>
          </div>
        </div>

        <!-- Düello Hedef Puanı -->
        <div>
          <label for="targetScoreSelect" class="block text-xs font-bold uppercase text-slate-400 mb-2">Tur Başına Soru / Hedef Sayısı</label>
          <select id="targetScoreSelect" class="w-full rounded-xl bg-slate-800 border border-slate-700 text-white px-3 py-2.5 font-bold text-sm">
            <option value="5">5 Doğru Cevap (Hızlı Tur)</option>
            <option value="8" selected>8 Doğru Cevap (Standart Ders Turu)</option>
            <option value="10">10 Doğru Cevap (Uzun Maraton)</option>
          </select>
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button id="applySettingsBtn" type="button" class="smartboard-btn w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base shadow-lg">
          ✅ Ayarları Uygula ve Oyunu Başlat
        </button>
      </div>
    </div>
  </div>

  <!-- TUR TAMAMLAMA / KUTLAMA MODALI -->
  <div id="victoryModal" class="hidden fixed inset-0 bg-slate-950/85 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-slate-900 border-2 border-amber-400 rounded-3xl max-w-md w-full p-6 text-center shadow-2xl">
      <div class="text-5xl mb-3 animate-float">🏆</div>
      <h3 id="victoryTitle" class="text-2xl font-black text-amber-300 mb-2">Harika İş Çıkardın!</h3>
      <p id="victorySubtitle" class="text-sm sm:text-base text-slate-200 mb-5">
        Tüm ritmik sayma adımlarını başarıyla tamamladın!
      </p>
      <button id="playAgainBtn" type="button" class="smartboard-btn w-full py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-lg shadow-xl">
        🚀 Yeni Tura Başla
      </button>
    </div>
  </div>

  <script>
    // ==========================================
    // SES EFEKTLERİ MOTORU (Web Audio API)
    // ==========================================
    const SoundFX = {
      ctx: null,
      enabled: true,
      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) {
            this.ctx = new AudioCtx();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },
      playTone(freq, type, duration, delay = 0, gainVal = 0.14) {
        if (!this.enabled) return;
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime + delay);
          gain.gain.setValueAtTime(gainVal, this.ctx.currentTime + delay);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + delay + duration);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(this.ctx.currentTime + delay);
          osc.stop(this.ctx.currentTime + delay + duration);
        } catch (e) {
          // Audio blocked or unsupported
        }
      },
      correct() {
        this.playTone(523.25, 'sine', 0.14, 0, 0.16);
        this.playTone(659.25, 'sine', 0.16, 0.1, 0.16);
        this.playTone(783.99, 'triangle', 0.25, 0.2, 0.18);
      },
      wrong() {
        this.playTone(240, 'sawtooth', 0.18, 0, 0.12);
        this.playTone(190, 'sawtooth', 0.24, 0.15, 0.12);
      },
      pop() {
        this.playTone(680, 'sine', 0.09, 0, 0.18);
        this.playTone(920, 'triangle', 0.12, 0.06, 0.15);
      },
      fanfare() {
        const notes = [523.25, 659.25, 783.99, 1046.5];
        notes.forEach((n, idx) => this.playTone(n, 'triangle', 0.22, idx * 0.12, 0.18));
      },
      musicEnabled: true,
      musicPlaying: false,
      musicTimer: null,
      musicStep: 0,
      noiseBuffer: null,
      // Heyecanlı Yarışma / Arcade Rekabet Müziği (32 adımlı yüksek enerjili La Minör / Mi Majör yürüyüşü)
      melodyNotes: [
        // 1. Ölçü (Am): Hızlı yükselen yarışma motifi
        440.00, 0, 523.25, 587.33,  659.25, 0, 659.25, 783.99,
        // 2. Ölçü (F): Gerilim ve hızlanma
        698.46, 659.25, 587.33, 523.25,  659.25, 0, 523.25, 0,
        // 3. Ölçü (G): Coşkulu tırmanış
        392.00, 0, 493.88, 587.33,  783.99, 0, 783.99, 880.00,
        // 4. Ölçü (E7): Heyecanlı final dönüşü
        659.25, 622.25, 659.25, 783.99,  880.00, 659.25, 987.77, 880.00
      ],
      arpNotes: [
        880.00, 659.25, 523.25, 659.25,  880.00, 659.25, 523.25, 659.25,
        698.46, 523.25, 440.00, 523.25,  698.46, 523.25, 440.00, 523.25,
        783.99, 587.33, 493.88, 587.33,  783.99, 587.33, 493.88, 587.33,
        659.25, 493.88, 415.30, 493.88,  659.25, 783.99, 880.00, 987.77
      ],
      bassNotes: [
        // Pompalayan oktav yarışma bası (Am - F - G - E)
        110.00, 220.00, 110.00, 220.00,  110.00, 220.00, 110.00, 220.00,
        87.31,  174.61, 87.31,  174.61,  87.31,  174.61, 87.31,  174.61,
        98.00,  196.00, 98.00,  196.00,  98.00,  196.00, 98.00,  196.00,
        82.41,  164.81, 82.41,  164.81,  82.41,  164.81, 98.00,  103.83
      ],
      ensureNoiseBuffer() {
        if (this.noiseBuffer || !this.ctx) return;
        const bufferSize = this.ctx.sampleRate * 0.15;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = Math.random() * 2 - 1;
        }
        this.noiseBuffer = buffer;
      },
      playKick() {
        if (!this.musicEnabled || !this.ctx) return;
        try {
          const now = this.ctx.currentTime;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(145, now);
          osc.frequency.exponentialRampToValueAtTime(42, now + 0.11);
          gain.gain.setValueAtTime(0.16, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.12);
        } catch (e) {}
      },
      playSnare() {
        if (!this.musicEnabled || !this.ctx) return;
        try {
          this.ensureNoiseBuffer();
          const now = this.ctx.currentTime;
          const noise = this.ctx.createBufferSource();
          noise.buffer = this.noiseBuffer;
          const filter = this.ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(1800, now);
          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(0.075, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
          noise.connect(filter);
          filter.connect(gain);
          gain.connect(this.ctx.destination);
          noise.start(now);
          noise.stop(now + 0.09);
        } catch (e) {}
      },
      playHiHat(accent = false) {
        if (!this.musicEnabled || !this.ctx) return;
        try {
          this.ensureNoiseBuffer();
          const now = this.ctx.currentTime;
          const noise = this.ctx.createBufferSource();
          noise.buffer = this.noiseBuffer;
          const filter = this.ctx.createBiquadFilter();
          filter.type = 'highpass';
          filter.frequency.setValueAtTime(6500, now);
          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(accent ? 0.038 : 0.018, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.035);
          noise.connect(filter);
          filter.connect(gain);
          gain.connect(this.ctx.destination);
          noise.start(now);
          noise.stop(now + 0.04);
        } catch (e) {}
      },
      playMusicNote(freq, type, duration, gainVal, filterFreq = 2400) {
        if (!this.musicEnabled || !freq) return;
        try {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime;
          const osc = this.ctx.createOscillator();
          const filter = this.ctx.createBiquadFilter();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, now);
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(filterFreq, now);
          gain.gain.setValueAtTime(0.001, now);
          gain.gain.linearRampToValueAtTime(gainVal, now + 0.012);
          gain.gain.exponentialRampToValueAtTime(0.0008, now + duration);
          osc.connect(filter);
          filter.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + duration);
        } catch (e) {}
      },
      playMusicTick() {
        if (!this.musicEnabled) return;
        const idx = this.musicStep % this.melodyNotes.length;
        const beatStep = idx % 8;

        // Ritim Grubu: Kick (0, 4), Snare/Clap (2, 6), Hi-Hat (her adımda, tek sayılarda vurgulu)
        if (beatStep === 0 || beatStep === 4) {
          this.playKick();
        }
        if (beatStep === 2 || beatStep === 6) {
          this.playSnare();
        }
        this.playHiHat(beatStep % 2 === 1);

        // Oktav Yarışma Bası
        const bass = this.bassNotes[idx];
        if (bass > 0) {
          this.playMusicNote(bass, 'sawtooth', 0.12, 0.065, 720);
        }

        // Arka Plan Hızlı Arpej (Heyecan hissi)
        const arp = this.arpNotes[idx];
        if (arp > 0) {
          this.playMusicNote(arp, 'triangle', 0.1, 0.035, 3200);
        }

        // Ana Rekabet Melodisi
        const mel = this.melodyNotes[idx];
        if (mel > 0) {
          this.playMusicNote(mel, 'square', 0.16, 0.055, 2400);
        }

        this.musicStep = (this.musicStep + 1) % this.melodyNotes.length;
      },
      startMusic() {
        if (!this.musicEnabled) return;
        this.init();
        if (this.musicTimer) return;
        this.musicPlaying = true;
        this.playMusicTick();
        // 130ms 16'lık nota adımı (~115 BPM tempolu yarışma ritmi)
        this.musicTimer = setInterval(() => {
          this.playMusicTick();
        }, 130);
      },
      stopMusic() {
        this.musicPlaying = false;
        if (this.musicTimer) {
          clearInterval(this.musicTimer);
          this.musicTimer = null;
        }
      },
      toggleMusic() {
        // Eğer müzik henüz başlamadıysa ilk tıklamada doğrudan başlat
        if (!this.musicPlaying) {
          this.musicEnabled = true;
          this.startMusic();
          return true;
        }
        this.musicEnabled = !this.musicEnabled;
        if (this.musicEnabled) {
          this.startMusic();
        } else {
          this.stopMusic();
        }
        return this.musicEnabled;
      }
    };

