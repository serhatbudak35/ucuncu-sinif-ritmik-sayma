          seqEl.appendChild(arrow);
        }
      });

      const grid = document.getElementById('answerButtonsGrid');
      grid.innerHTML = '';
      const colors = [
        'from-emerald-500 to-teal-600 border-emerald-300',
        'from-sky-500 to-blue-600 border-sky-300',
        'from-violet-500 to-purple-600 border-violet-300',
        'from-amber-500 to-orange-600 border-amber-300'
      ];

      state.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `smartboard-btn py-5 sm:py-6 rounded-2xl bg-gradient-to-b ${colors[idx % colors.length]} border-2 text-white font-black text-2xl sm:text-4xl shadow-xl flex items-center justify-center`;
        btn.textContent = String(opt);
        btn.addEventListener('click', () => handleRiverAnswer(opt, btn));
        grid.appendChild(btn);
