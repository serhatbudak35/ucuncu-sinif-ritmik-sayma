        label.className = 'text-sm sm:text-base font-extrabold text-emerald-300';
      } else if (type === 'error') {
        banner.className = 'absolute top-3 left-1/2 -translate-x-1/2 px-4 py-2 rounded-2xl bg-rose-950/95 border-2 border-rose-400 shadow-xl text-center pointer-events-none shake';
        label.className = 'text-sm sm:text-base font-extrabold text-rose-200';
      } else {
        banner.className = 'absolute top-3 left-1/2 -translate-x-1/2 px-4 py-2 rounded-2xl bg-slate-900/90 border border-slate-600 shadow-xl text-center pointer-events-none';
        label.className = 'text-sm sm:text-base font-extrabold text-amber-300';
      }
    }

    // ==========================================
    // MOD 1: NEHİR GEÇİŞİ (KURBAĞA ZIPLAMA)
    // ==========================================
    function loadRiverQuestion() {
      document.getElementById('hintVisualBox').classList.add('hidden');
      const q = generateSequenceQuestion();
      state.currentSequence = q.seq;
      state.missingIndex = q.missingIndex;
      state.correctAnswer = q.answer;
      state.options = q.options;

      renderRiverSequenceAndButtons();
      setFeedback(`Kurbağayı zıplatmak için sıradaki sayıyı seç! (${state.riverProgress} / ${state.targetGoal})`, 'info');
    }

