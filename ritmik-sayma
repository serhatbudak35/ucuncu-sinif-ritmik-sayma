        <div id="hintVisualBox" class="hidden bg-indigo-950/90 border border-indigo-400/50 rounded-xl p-3 text-center">
          <p id="hintVisualText" class="text-sm sm:text-base font-bold text-indigo-200"></p>
          <div id="hintDotsContainer" class="flex flex-wrap justify-center gap-2 mt-2"></div>
