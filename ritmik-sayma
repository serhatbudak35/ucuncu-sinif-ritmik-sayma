      const seqEl = document.getElementById('sequenceDisplay');
      seqEl.innerHTML = '';

      state.currentSequence.forEach((num, idx) => {
        const box = document.createElement('div');
        if (idx === state.missingIndex) {
          box.id = 'missingNumberSlot';
          box.className = 'px-4 py-2 sm:px-5 sm:py-2.5 rounded-2xl bg-amber-400/20 border-2 border-dashed border-amber-400 text-amber-300 font-black text-xl sm:text-2xl animate-pulse';
          box.textContent = '?';
        } else {
          box.className = 'px-4 py-2 sm:px-5 sm:py-2.5 rounded-2xl bg-slate-800 border-2 border-slate-600 text-white font-black text-xl sm:text-2xl shadow';
          box.textContent = String(num);
        }
        seqEl.appendChild(box);

        if (idx < state.currentSequence.length - 1) {
