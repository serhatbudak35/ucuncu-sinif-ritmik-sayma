        <!-- Büyük Dokunmatik Cevap Butonları (Akıllı Tahta İçin Alt Bölgede Dev Butonlar) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-1" id="answerButtonsGrid">
