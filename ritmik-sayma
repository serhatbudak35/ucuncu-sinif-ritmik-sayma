    function handleRiverAnswer(selected, btnElement) {
      if (selected === state.correctAnswer) {
        SoundFX.correct();
        state.score += 10;
        state.streak += 1;
        state.riverProgress += 1;
        state.frogJumpAnim = 1.0;

        const slot = document.getElementById('missingNumberSlot');
        if (slot) {
          slot.textContent = String(selected);
          slot.className = 'px-4 py-2 sm:px-5 sm:py-2.5 rounded-2xl bg-emerald-500 text-slate-950 font-black text-xl sm:text-2xl pop-success';
        }

        updateHeaderBadges();
        setFeedback(`Harika! ${selected} doğru cevap! 🐸`, 'success');

        // Butonları kısa süre kilitle
        Array.from(document.getElementById('answerButtonsGrid').children).forEach(b => {
          b.disabled = true;
        });

        setTimeout(() => {
          if (state.riverProgress >= state.targetGoal) {
            showVictoryModal(
              'Nehri Başarıyla Geçtin! 🐸🏆',
              `${state.step}'ar ritmik saymada ${state.targetGoal} nilüfer yaprağının tamamını doğru geçtin!`
            );
          } else {
            loadRiverQuestion();
          }
        }, 750);
      } else {
        SoundFX.wrong();
        state.streak = 0;
        updateHeaderBadges();
        btnElement.classList.add('shake', 'opacity-50');
        btnElement.disabled = true;
        showHintVisual();
        const prevNum = state.currentSequence[state.missingIndex - 1];
        const opSymbol = state.direction === 'forward' ? '+' : '-';
        setFeedback(
          `Tekrar dene! İpucu: ${prevNum} ${opSymbol} ${state.step} kaç eder?`,
          'error'
        );
      }
    }

    function showHintVisual() {
      const box = document.getElementById('hintVisualBox');
      const text = document.getElementById('hintVisualText');
      const dots = document.getElementById('hintDotsContainer');
      box.classList.remove('hidden');

      const prevNum = state.currentSequence[state.missingIndex - 1];
      const isForward = state.direction === 'forward';
      text.textContent = isForward
        ? `💡 İpucu: ${prevNum} sayısının üzerine ${state.step} adım ileriye sayalım:`
        : `💡 İpucu: ${prevNum} sayısından ${state.step} adım geriye sayalım:`;

      dots.innerHTML = '';
      if (state.step <= 10) {
        for (let i = 1; i <= state.step; i++) {
          const stepVal = isForward ? prevNum + i : prevNum - i;
          const badge = document.createElement('span');
          const isLast = i === state.step;
          badge.className = isLast
            ? 'px-3 py-1 rounded-xl bg-amber-400 text-slate-950 font-black text-sm shadow'
            : 'px-2.5 py-1 rounded-xl bg-indigo-800 text-indigo-100 font-bold text-xs';
          badge.textContent = isLast ? `${stepVal} ⭐` : String(stepVal);
          dots.appendChild(badge);
        }
      } else {
        const badge = document.createElement('span');
        badge.className = 'px-4 py-1.5 rounded-xl bg-amber-400 text-slate-950 font-black text-base';
        badge.textContent = `${prevNum} ${isForward ? '+' : '-'} ${state.step} = ${state.correctAnswer}`;
        dots.appendChild(badge);
      }
    }

    // ==========================================
    // MOD 2: BALON AVCISI (KATLARI YAKALA)
    // ==========================================
    function initBalloonRound() {
      state.balloonHits = 0;
      state.balloonGoal = 5;
      state.balloons = [];

      const suffixMap = { 6: "'nın", 7: "'nin", 8: "'in", 9: "'un", 10: "'un", 100: "'ün" };
      const suf = suffixMap[state.step] || "'in";
      document.getElementById('balloonMissionTitle').textContent =
        `🎯 Görev: Sadece ${state.step}${suf} Katı Olan Balonları Patlat!`;
      document.getElementById('balloonRemainingBadge').textContent =
        `Hedef: 0 / ${state.balloonGoal}`;
      setFeedback(`${state.step}${suf} katı olan balonlara dokun!`, 'info');

      spawnBalloonWave();
    }

    function spawnBalloonWave() {
      const step = state.step;
      const palette = ['#f43f5e', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'];

      // 3 doğru kat, 3 çeldirici üret
      const correctNums = [];
      const used = new Set();
      while (correctNums.length < 3) {
        const mult = Math.floor(Math.random() * 10) + 1;
        const val = mult * step;
        if (!used.has(val)) {
          used.add(val);
          correctNums.push({ num: val, isTarget: true });
        }
      }

      const wrongNums = [];
      while (wrongNums.length < 3) {
        const mult = Math.floor(Math.random() * 10) + 1;
        const offset = (Math.floor(Math.random() * 3) + 1) * (Math.random() > 0.5 ? 1 : -1);
        const val = Math.max(2, mult * step + offset);
        if (val % step !== 0 && !used.has(val)) {
          used.add(val);
          wrongNums.push({ num: val, isTarget: false });
        }
      }

      const combined = [...correctNums, ...wrongNums];
      for (let i = combined.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [combined[i], combined[j]] = [combined[j], combined[i]];
      }

      state.balloons = combined.map((item, idx) => ({
        id: 'bal_' + idx + '_' + Date.now(),
        num: item.num,
        isTarget: item.isTarget,
        popped: false,
        wrongShake: 0,
        colIndex: idx,
        floatPhase: idx * 1.1,
        color: palette[idx % palette.length]
      }));

      renderBalloonQuickButtons();
    }

    function renderBalloonQuickButtons() {
      const grid = document.getElementById('balloonQuickGrid');
      grid.innerHTML = '';
      state.balloons.forEach(b => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.disabled = b.popped;
        btn.className = b.popped
          ? 'py-4 rounded-2xl bg-slate-900 border border-slate-800 text-slate-600 font-black text-xl line-through'
          : 'smartboard-btn py-4 rounded-2xl bg-slate-700 hover:bg-slate-600 border-2 border-slate-500 text-white font-black text-2xl shadow-lg';
        btn.textContent = b.popped ? '💥' : `🎈 ${b.num}`;
        btn.addEventListener('click', () => handleBalloonTap(b.id));
        grid.appendChild(btn);
      });
    }

    function handleBalloonTap(balloonId) {
      const b = state.balloons.find(item => item.id === balloonId);
      if (!b || b.popped) return;

      if (b.isTarget) {
        b.popped = true;
        SoundFX.pop();
        state.score += 10;
        state.streak += 1;
        state.balloonHits += 1;
        updateHeaderBadges();
        document.getElementById('balloonRemainingBadge').textContent =
          `Hedef: ${state.balloonHits} / ${state.balloonGoal}`;
        setFeedback(`Süper! ${b.num}, ${state.step} sayısının katıdır! 💥`, 'success');
        renderBalloonQuickButtons();

        if (state.balloonHits >= state.balloonGoal) {
          setTimeout(() => {
            showVictoryModal(
              'Usta Balon Avcısı! 🎈🏆',
              `${state.step}'ar ritmik sayma katlarının hepsini doğru yakaladın!`
            );
          }, 500);
        } else {
          const remainingTargets = state.balloons.filter(x => x.isTarget && !x.popped);
          if (remainingTargets.length === 0) {
            setTimeout(spawnBalloonWave, 600);
          }
        }
      } else {
        b.wrongShake = 1.0;
        SoundFX.wrong();
        state.streak = 0;
        updateHeaderBadges();
        setFeedback(`Dikkat! ${b.num} sayısı ${state.step}'ar saymada yer almaz.`, 'error');
      }
    }

    // ==========================================
    // MOD 3: İKİLİ AKILLI TAHTA DÜELLOSU
    // ==========================================
    function initDuelGame() {
      state.duel.left.score = 0;
      state.duel.right.score = 0;
      document.getElementById('duelScoreLeft').textContent = 'Puan: 0';
      document.getElementById('duelScoreRight').textContent = 'Puan: 0';
      loadDuelSideQuestion('left');
      loadDuelSideQuestion('right');
    }

    function loadDuelSideQuestion(side) {
      const q = generateSequenceQuestion();
      const d = state.duel[side];
      d.seq = q.seq;
      d.missingIdx = q.missingIndex;
      d.answer = q.answer;
      d.options = q.options;
      d.locked = false;

      const isLeft = side === 'left';
      const trainEl = document.getElementById(isLeft ? 'duelTrainLeft' : 'duelTrainRight');
      const optEl = document.getElementById(isLeft ? 'duelOptionsLeft' : 'duelOptionsRight');
      const ruleEl = document.getElementById(isLeft ? 'duelRuleLeft' : 'duelRuleRight');
      const fbEl = document.getElementById(isLeft ? 'duelFeedbackLeft' : 'duelFeedbackRight');

      const dirText = state.direction === 'forward' ? 'İleriye' : 'Geriye';
      ruleEl.textContent = `${state.step}'ar ${dirText} Ritmik Sayma (${d.score} / ${state.targetGoal})`;
      fbEl.textContent = 'Eksik vagonu aşağıdan seç!';
      fbEl.className = 'text-center text-sm font-bold text-slate-300 mt-3 h-5';

      trainEl.innerHTML = '';
      d.seq.forEach((num, idx) => {
        const wagon = document.createElement('div');
        if (idx === d.missingIdx) {
          wagon.className = 'px-4 py-3 rounded-xl bg-amber-400/20 border-2 border-dashed border-amber-400 text-amber-300 font-black text-2xl';
          wagon.textContent = '?';
        } else {
          wagon.className = 'px-4 py-3 rounded-xl bg-slate-800 border-2 border-slate-600 text-white font-black text-2xl';
          wagon.textContent = String(num);
        }
        trainEl.appendChild(wagon);
      });

      optEl.innerHTML = '';
      d.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = isLeft
          ? 'smartboard-btn py-5 rounded-2xl bg-sky-600 hover:bg-sky-500 border-2 border-sky-300 text-white font-black text-3xl shadow-lg'
          : 'smartboard-btn py-5 rounded-2xl bg-rose-600 hover:bg-rose-500 border-2 border-rose-300 text-white font-black text-3xl shadow-lg';
        btn.textContent = String(opt);
        btn.addEventListener('click', () => handleDuelAnswer(side, opt, btn));
        optEl.appendChild(btn);
      });
    }

    function handleDuelAnswer(side, selected, btn) {
      const d = state.duel[side];
      if (d.locked) return;

      const isLeft = side === 'left';
      const fbEl = document.getElementById(isLeft ? 'duelFeedbackLeft' : 'duelFeedbackRight');
      const scoreEl = document.getElementById(isLeft ? 'duelScoreLeft' : 'duelScoreRight');

      if (selected === d.answer) {
        d.locked = true;
        d.score += 1;
        state.score += 10;
        SoundFX.correct();
        updateHeaderBadges();
        scoreEl.textContent = `Puan: ${d.score}`;
        fbEl.textContent = `Harika! ${selected} Doğru! 🎉`;
        fbEl.className = 'text-center text-sm font-black text-emerald-400 mt-3 h-5';

        if (d.score >= state.targetGoal) {
          const winnerName = isLeft ? 'MAVİ TAKIM' : 'KIRMIZI TAKIM';
          setTimeout(() => {
            showVictoryModal(
              `🏆 ${winnerName} KAZANDI!`,
              `Tebrikler! ${winnerName} ${state.targetGoal} vagona doğru sayıları yerleştirerek yarışı birinci tamamladı!`
            );
          }, 400);
        } else {
          setTimeout(() => loadDuelSideQuestion(side), 550);
        }
      } else {
        SoundFX.wrong();
        btn.disabled = true;
        btn.classList.add('opacity-40', 'shake');
        fbEl.textContent = `Dikkat! ${state.step}'ar sayarak tekrar dene!`;
        fbEl.className = 'text-center text-sm font-bold text-amber-300 mt-3 h-5';
      }
    }

    // ==========================================
    // CANVAS ÇİZİM MOTORU (NEHİR & BALON SAHNESİ)
    // ==========================================
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      const container = document.getElementById('canvasContainer');
      if (!container) return;
      const rect = container.getBoundingClientRect();
      if (rect.width > 0 && rect.height > 0) {
        canvas.width = rect.width;
        canvas.height = rect.height;
      }
    }

    function drawRiverScene(time) {
      const w = canvas.width;
      const h = canvas.height;

      // Nehir arka planı
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, '#0284c7');
      grad.addColorStop(1, '#0369a1');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);

      // Sol ve Sağ Kıyı Çimleri
      ctx.fillStyle = '#15803d';
      ctx.fillRect(0, 0, 56, h);
      ctx.fillRect(w - 56, 0, 56, h);

      // Su dalgası çizgileri
      ctx.strokeStyle = 'rgba(255,255,255,0.18)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 5; i++) {
        const y = ((i + 1) * h) / 6;
        const offset = Math.sin(time * 0.002 + i) * 12;
        ctx.beginPath();
        ctx.moveTo(75 + offset, y);
        ctx.lineTo(w - 75 + offset, y);
        ctx.stroke();
      }

      // Nilüfer yaprakları (4 adım)
      const padCount = 4;
      const usableW = w - 160;
      const startX = 95;
      const centerY = h * 0.62;

      for (let i = 0; i < padCount; i++) {
        const px = startX + (usableW / (padCount - 1)) * i;
        const py = centerY + (i % 2 === 0 ? -12 : 12);

        // Nilüfer gölgesi
        ctx.fillStyle = 'rgba(0,0,0,0.22)';
        ctx.beginPath();
        ctx.ellipse(px, py + 5, 36, 22, 0, 0, Math.PI * 2);
        ctx.fill();

        // Nilüfer yaprağı
        ctx.fillStyle = i === state.missingIndex ? '#fbbf24' : '#22c55e';
        ctx.beginPath();
        ctx.ellipse(px, py, 36, 22, 0, 0.2, Math.PI * 1.9);
        ctx.lineTo(px, py);
        ctx.closePath();
        ctx.fill();

        // Üzerindeki sayı
        ctx.fillStyle = '#0f172a';
        ctx.font = '900 18px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        const valText = i === state.missingIndex ? '?' : String(state.currentSequence[i] || '');
        ctx.fillText(valText, px, py);

        // Kurbağayı 3. yaprakta (soru yaprağından hemen önce) çiz
        if (i === state.missingIndex - 1) {
          let jumpOffset = 0;
          if (state.frogJumpAnim > 0) {
            jumpOffset = Math.sin(state.frogJumpAnim * Math.PI) * -35;
            state.frogJumpAnim = Math.max(0, state.frogJumpAnim - 0.05);
          }
          drawCuteFrog(px, py - 24 + jumpOffset);
        }
      }
    }

    function drawCuteFrog(x, y) {
      // Gövde
      ctx.fillStyle = '#4ade80';
      ctx.beginPath();
      ctx.ellipse(x, y, 22, 17, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#14532d';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // Gözler
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(x - 10, y - 14, 7, 0, Math.PI * 2);
      ctx.arc(x + 10, y - 14, 7, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.arc(x - 10, y - 14, 3.5, 0, Math.PI * 2);
      ctx.arc(x + 10, y - 14, 3.5, 0, Math.PI * 2);
      ctx.fill();

      // Gülümseme
      ctx.strokeStyle = '#14532d';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(x, y - 2, 9, 0.15 * Math.PI, 0.85 * Math.PI);
      ctx.stroke();
    }

    function drawBalloonScene(time) {
      const w = canvas.width;
      const h = canvas.height;

      // Gökyüzü arka planı
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, '#1e1b4b');
      grad.addColorStop(1, '#312e81');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);

      const count = state.balloons.length || 6;
      const spacing = w / (count + 1);

      state.balloons.forEach((b, idx) => {
        if (b.popped) return;
        const baseX = spacing * (idx + 1);
        const floatY = h * 0.54 + Math.sin(time * 0.003 + b.floatPhase) * 14;
        let shakeX = 0;
        if (b.wrongShake > 0) {
          shakeX = Math.sin(b.wrongShake * 25) * 8;
          b.wrongShake = Math.max(0, b.wrongShake - 0.05);
        }

        b.renderX = baseX + shakeX;
        b.renderY = floatY;
        b.radius = Math.min(36, Math.max(26, w / 22));

        // Balon ipi
        ctx.strokeStyle = 'rgba(255,255,255,0.45)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(b.renderX, b.renderY + b.radius);
        ctx.lineTo(b.renderX, b.renderY + b.radius + 26);
        ctx.stroke();

        // Balon gövdesi
        ctx.fillStyle = b.color;
        ctx.beginPath();
        ctx.ellipse(b.renderX, b.renderY, b.radius, b.radius * 1.15, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2.5;
        ctx.stroke();

        // Parlama
        ctx.fillStyle = 'rgba(255,255,255,0.28)';
        ctx.beginPath();
        ctx.ellipse(b.renderX - b.radius * 0.32, b.renderY - b.radius * 0.35, b.radius * 0.2, b.radius * 0.32, -0.4, 0, Math.PI * 2);
        ctx.fill();

        // Sayı
        ctx.fillStyle = '#ffffff';
        ctx.font = `900 ${Math.round(b.radius * 0.72)}px Inter, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(String(b.num), b.renderX, b.renderY);
      });
    }

    function gameLoop(time) {
      if (state.mode === 'river') {
        drawRiverScene(time);
      } else if (state.mode === 'balloon') {
        drawBalloonScene(time);
      }
      animFrameId = requestAnimationFrame(gameLoop);
    }

    // Canvas üzerine doğrudan dokunma (Balon Avcısı için)
    canvas.addEventListener('pointerdown', (e) => {
      if (state.mode !== 'balloon') return;
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const x = (e.clientX - rect.left) * scaleX;
      const y = (e.clientY - rect.top) * scaleY;

      for (const b of state.balloons) {
        if (b.popped || !b.renderX) continue;
        const dx = x - b.renderX;
        const dy = y - b.renderY;
        if (Math.sqrt(dx * dx + dy * dy) <= (b.radius || 34) * 1.25) {
          handleBalloonTap(b.id);
          break;
        }
      }
    });

    // ==========================================
    // MOD DEĞİŞTİRME VE KONTROLLER
    // ==========================================
    function switchMode(newMode) {
      state.mode = newMode;
      const riverBtn = document.getElementById('modeRiverBtn');
      const balloonBtn = document.getElementById('modeBalloonBtn');
      const duelBtn = document.getElementById('modeDuelBtn');

      const activeClass = 'smartboard-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-emerald-500 text-slate-950 shadow';
      const inactiveClass = 'smartboard-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-slate-200 hover:bg-slate-700';

      riverBtn.className = newMode === 'river' ? activeClass : inactiveClass;
      balloonBtn.className = newMode === 'balloon' ? activeClass : inactiveClass;
      duelBtn.className = newMode === 'duel' ? activeClass : inactiveClass;

      const singleSec = document.getElementById('singleBoardSection');
      const duelSec = document.getElementById('duelBoardSection');
      const riverCtrl = document.getElementById('riverControlsArea');
      const balloonCtrl = document.getElementById('balloonControlsArea');

      if (newMode === 'duel') {
        singleSec.classList.add('hidden');
        duelSec.classList.remove('hidden');
        initDuelGame();
      } else {
        duelSec.classList.add('hidden');
        singleSec.classList.remove('hidden');
        resizeCanvas();
        if (newMode === 'river') {
          riverCtrl.classList.remove('hidden');
          balloonCtrl.classList.add('hidden');
          state.riverProgress = 0;
          loadRiverQuestion();
        } else {
          riverCtrl.classList.add('hidden');
          balloonCtrl.classList.remove('hidden');
          balloonCtrl.classList.add('flex');
          initBalloonRound();
        }
      }
      updateHeaderBadges();
    }

    function showVictoryModal(title, subtitle) {
      SoundFX.fanfare();
      document.getElementById('victoryTitle').textContent = title;
      document.getElementById('victorySubtitle').textContent = subtitle;
      document.getElementById('victoryModal').classList.remove('hidden');
    }

    function resetCurrentMode() {
      document.getElementById('victoryModal').classList.add('hidden');
      state.riverProgress = 0;
      switchMode(state.mode);
    }

    // ==========================================
    // EVENT LISTENERS (ETKİLEŞİMLER)
    // ==========================================
    window.addEventListener('load', () => {
      resizeCanvas();
      updateHeaderBadges();
      loadRiverQuestion();
      if (animFrameId) cancelAnimationFrame(animFrameId);
      animFrameId = requestAnimationFrame(gameLoop);
    });

    window.addEventListener('resize', () => {
      resizeCanvas();
    });

    document.getElementById('modeRiverBtn').addEventListener('click', () => switchMode('river'));
    document.getElementById('modeBalloonBtn').addEventListener('click', () => switchMode('balloon'));
    document.getElementById('modeDuelBtn').addEventListener('click', () => switchMode('duel'));

    document.querySelectorAll('.step-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        state.step = Number(btn.getAttribute('data-step'));
        resetCurrentMode();
      });
    });

    document.getElementById('hintBtn').addEventListener('click', () => {
      showHintVisual();
    });

    document.getElementById('musicToggleBtn').addEventListener('click', (e) => {
      const isOn = SoundFX.toggleMusic();
      e.currentTarget.textContent = isOn ? '🎵 Müzik Açık' : '🎵 Müzik Kapalı';
      e.currentTarget.className = isOn
        ? 'smartboard-btn px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs sm:text-sm shadow'
        : 'smartboard-btn px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-300 font-bold text-xs sm:text-sm';
    });

    document.getElementById('soundToggleBtn').addEventListener('click', (e) => {
      SoundFX.enabled = !SoundFX.enabled;
      e.currentTarget.textContent = SoundFX.enabled ? '🔊 Ses Açık' : '🔇 Ses Kapalı';
    });

    // İlk dokunuşta veya tıklamada arka plan müziğini otomatik başlat (musicToggleBtn hariç çakışmayı önle)
    function unlockAudioOnGesture(e) {
      if (e && e.target && e.target.closest && e.target.closest('#musicToggleBtn')) {
        return;
      }
      if (SoundFX.musicEnabled && !SoundFX.musicTimer) {
        SoundFX.startMusic();
      }
    }
    document.addEventListener('pointerdown', unlockAudioOnGesture);
    document.addEventListener('keydown', unlockAudioOnGesture);

    document.getElementById('resetGameBtn').addEventListener('click', () => {
      resetCurrentMode();
    });

    document.getElementById('playAgainBtn').addEventListener('click', () => {
      resetCurrentMode();
    });

    // Ayarlar Modalı Kontrolleri
    document.getElementById('openSettingsBtn').addEventListener('click', () => {
      document.getElementById('settingsModal').classList.remove('hidden');
    });

    document.getElementById('closeSettingsBtn').addEventListener('click', () => {
      document.getElementById('settingsModal').classList.add('hidden');
    });

    document.getElementById('dirForwardBtn').addEventListener('click', () => {
      state.direction = 'forward';
      document.getElementById('dirForwardBtn').className = 'smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-emerald-500 text-slate-950';
      document.getElementById('dirBackwardBtn').className = 'smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700';
    });

    document.getElementById('dirBackwardBtn').addEventListener('click', () => {
      state.direction = 'backward';
      document.getElementById('dirBackwardBtn').className = 'smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-emerald-500 text-slate-950';
      document.getElementById('dirForwardBtn').className = 'smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700';
    });

    document.getElementById('startStandardBtn').addEventListener('click', () => {
      state.startMode = 'standard';
      document.getElementById('startStandardBtn').className = 'smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-amber-400 text-slate-950';
      document.getElementById('startCustomBtn').className = 'smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700';
    });

    document.getElementById('startCustomBtn').addEventListener('click', () => {
      state.startMode = 'custom';
      document.getElementById('startCustomBtn').className = 'smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-amber-400 text-slate-950';
      document.getElementById('startStandardBtn').className = 'smartboard-btn py-2.5 px-3 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700';
    });

    document.getElementById('applySettingsBtn').addEventListener('click', () => {
      const sel = document.getElementById('targetScoreSelect');
      state.targetGoal = Number(sel.value) || 8;
      document.getElementById('settingsModal').classList.add('hidden');
      resetCurrentMode();
    });
  </script>
</body>
