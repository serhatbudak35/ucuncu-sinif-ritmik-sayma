    // ==========================================
    // YARDIMCI MATEMATİK VE SORU ÜRETİCİ
    // ==========================================
    function getMaxLimit(step) {
      if (step === 100) return 1000;
      if (step === 10) return 200;
      return 100; // 3. sınıf 6, 7, 8, 9'ar ritmik sayma 100 içinde
    }

    function generateSequenceQuestion() {
      const step = state.step;
      const isForward = state.direction === 'forward';
      const seqLength = 4;

      let startNum = step;
      if (state.startMode === 'standard') {
        const maxMult = step === 100 ? 6 : (step === 10 ? 12 : Math.floor((100 - step * seqLength) / step));
        const safeMax = Math.max(1, maxMult);
        const mult = Math.floor(Math.random() * safeMax) + 1;
        startNum = mult * step;
      } else {
        // Rastgele sayıdan başlayarak (ör. 14'ten başlayıp 6'şar)
        const baseMax = step === 100 ? 400 : (step === 10 ? 110 : 100 - step * seqLength - 2);
        startNum = Math.floor(Math.random() * Math.max(5, baseMax)) + 4;
      }

      if (!isForward) {
        startNum = startNum + step * (seqLength - 1);
      }

      const seq = [];
      for (let i = 0; i < seqLength; i++) {
        seq.push(isForward ? startNum + i * step : startNum - i * step);
      }

      // 3. veya 4. terimi sor (Nehir modunda son terim, düelloda 2 veya 3. indeks)
      const missingIndex = state.mode === 'river' ? 3 : (Math.random() > 0.4 ? 3 : 2);
      const answer = seq[missingIndex];

      // Akıllı çeldiriciler (3. sınıf öğrencilerinin sık yaptığı +1/-1 veya yakın kat hataları)
      const distractors = new Set();
      const candidates = [
        answer + 1,
        answer - 1,
        answer + 2,
        answer - 2,
        answer + step,
        Math.max(1, answer - step),
        answer + (step - 1),
        Math.max(1, answer - (step - 1))
      ];
      for (const c of candidates) {
        if (c > 0 && c !== answer && distractors.size < 3) {
          distractors.add(c);
        }
      }
      while (distractors.size < 3) {
        const rand = answer + (Math.floor(Math.random() * 9) - 4);
        if (rand > 0 && rand !== answer) distractors.add(rand);
      }

      const options = [answer, ...Array.from(distractors)];
      // Karıştır
      for (let i = options.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [options[i], options[j]] = [options[j], options[i]];
      }

      return { seq, missingIndex, answer, options };
    }

    // ==========================================
    // ARAYÜZ GÜNCELLEME FONKSİYONLARI
    // ==========================================
    function updateHeaderBadges() {
      const dirText = state.direction === 'forward' ? 'İleriye' : 'Geriye';
      const suffixMap = { 6: "'şar", 7: "'şer", 8: "'er", 9: "'ar", 10: "'ar", 100: "'er" };
      const suf = suffixMap[state.step] || "'ar";
      document.getElementById('activeRuleBadge').textContent =
        `Kural: ${state.step}${suf} ${dirText} Ritmik Sayma`;
      document.getElementById('scoreBadge').textContent =
        `⭐ Puan: ${state.score} | 🔥 Seri: ${state.streak}`;

      document.querySelectorAll('.step-chip').forEach(btn => {
        const s = Number(btn.getAttribute('data-step'));
        if (s === state.step) {
          btn.className = 'step-chip smartboard-btn px-2.5 py-1 rounded-lg text-xs font-extrabold bg-amber-400 text-slate-950 shadow';
        } else {
          btn.className = 'step-chip smartboard-btn px-2.5 py-1 rounded-lg text-xs font-extrabold bg-slate-800 text-slate-200 border border-slate-700';
        }
      });
    }

