<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>3. Sınıf Ritmik Sayma Macerası - Akıllı Tahta Oyunu</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #f8fafc;
    }
    .smartboard-btn {
      transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.12s ease;
      touch-action: manipulation;
    }
    .smartboard-btn:active:not(:disabled) {
      transform: scale(0.94);
    }
    @keyframes bounceSlow {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
    .animate-float {
      animation: bounceSlow 2.4s infinite ease-in-out;
    }
    @keyframes shakeError {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-8px); }
      50% { transform: translateX(8px); }
      75% { transform: translateX(-6px); }
    }
    .shake {
      animation: shakeError 0.38s ease-in-out;
    }
    @keyframes popCorrect {
      0% { transform: scale(0.9); }
      50% { transform: scale(1.08); }
      100% { transform: scale(1); }
    }
    .pop-success {
      animation: popCorrect 0.35s ease-out;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

  <!-- ÜST ÖĞRETMEN VE KONTROL BARI -->
  <header class="w-full bg-slate-900/90 border-b border-slate-700/80 px-3 py-2.5 shadow-lg z-20">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <!-- Başlık & Rozet -->
      <div class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center shadow-md text-slate-950 font-black text-xl">
          3
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-extrabold tracking-tight text-white leading-tight">
            Ritmik Sayma Macerası
          </h1>
          <p class="text-xs text-slate-300 hidden sm:block">3. Sınıf Akıllı Tahta Etkileşimli Matematik Oyunu</p>
        </div>
      </div>

      <!-- Oyun Modu Seçici Sekmeler -->
      <nav class="flex items-center bg-slate-800 p-1 rounded-xl border border-slate-700 gap-1" aria-label="Oyun Modları">
        <button id="modeRiverBtn" type="button" class="smartboard-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-emerald-500 text-slate-950 shadow">
          🐸 Nehir Geçişi
        </button>
        <button id="modeBalloonBtn" type="button" class="smartboard-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-slate-200 hover:bg-slate-700">
          🎈 Balon Avcısı
        </button>
        <button id="modeDuelBtn" type="button" class="smartboard-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-slate-200 hover:bg-slate-700">
          🚂 İkili Düello
        </button>
      </nav>

      <!-- Sağ Kontroller: Ayarlar, Ses, Sıfırla -->
      <div class="flex items-center gap-2">
        <button id="openSettingsBtn" type="button" class="smartboard-btn px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow">
          <span>⚙️ Sayma Ayarları</span>
        </button>
        <button id="musicToggleBtn" type="button" class="smartboard-btn px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs sm:text-sm shadow" title="Arka Plan Müziğini Aç/Kapat">
          🎵 Müzik Açık
        </button>
        <button id="soundToggleBtn" type="button" class="smartboard-btn px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-100 font-bold text-xs sm:text-sm" title="Ses Efektlerini Aç/Kapat">
          🔊 Ses Açık
        </button>
        <button id="resetGameBtn" type="button" class="smartboard-btn px-3 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs sm:text-sm shadow">
          🔄 Yeni Tur
        </button>
      </div>
    </div>

    <!-- Aktif Kazanım Bilgi Şeridi & Hızlı Sayı Seçici -->
    <div class="max-w-7xl mx-auto mt-2 pt-2 border-t border-slate-800 flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-xs font-bold text-slate-400 mr-1">Hızlı Seçim:</span>
        <button type="button" data-step="6" class="step-chip smartboard-btn px-2.5 py-1 rounded-lg text-xs font-extrabold bg-amber-400 text-slate-950">6'şar</button>
        <button type="button" data-step="7" class="step-chip smartboard-btn px-2.5 py-1 rounded-lg text-xs font-extrabold bg-slate-800 text-slate-200 border border-slate-700">7'şer</button>
        <button type="button" data-step="8" class="step-chip smartboard-btn px-2.5 py-1 rounded-lg text-xs font-extrabold bg-slate-800 text-slate-200 border border-slate-700">8'er</button>
        <button type="button" data-step="9" class="step-chip smartboard-btn px-2.5 py-1 rounded-lg text-xs font-extrabold bg-slate-800 text-slate-200 border border-slate-700">9'ar</button>
        <button type="button" data-step="10" class="step-chip smartboard-btn px-2.5 py-1 rounded-lg text-xs font-extrabold bg-slate-800 text-slate-200 border border-slate-700">10'ar</button>
        <button type="button" data-step="100" class="step-chip smartboard-btn px-2.5 py-1 rounded-lg text-xs font-extrabold bg-slate-800 text-slate-200 border border-slate-700">100'er</button>
      </div>

      <div class="flex items-center gap-3 text-xs sm:text-sm">
        <span id="activeRuleBadge" class="px-2.5 py-1 rounded-lg bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 font-bold">
          Kural: 6'şar İleriye Ritmik Sayma
        </span>
        <span id="scoreBadge" class="px-3 py-1 rounded-lg bg-amber-500/20 border border-amber-400/40 text-amber-300 font-extrabold">
          ⭐ Puan: 0 | Seri: 0
        </span>
      </div>
    </div>
  </header>

  <!-- ANA OYUN ALANI -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-3 py-3 flex flex-col justify-between gap-3">

    <!-- ========================================== -->
    <!-- MOD 1 & MOD 2: TEK EKRAN CANVAS + ALT PANEL -->
    <!-- ========================================== -->
    <section id="singleBoardSection" class="flex-1 flex flex-col justify-between gap-3">
      
      <!-- Görsel Canvas Sahnesi (Üst %45) -->
      <div id="canvasContainer" class="relative w-full h-56 sm:h-64 md:h-72 rounded-2xl overflow-hidden border-2 border-slate-700 shadow-2xl bg-slate-900">
        <canvas id="gameCanvas" class="w-full h-full block cursor-pointer"></canvas>

        <!-- İpucu ve Durum Baloncuğu (Canvas Üzeri) -->
        <div id="feedbackBanner" class="absolute top-3 left-1/2 -translate-x-1/2 px-4 py-2 rounded-2xl bg-slate-900/90 border border-slate-600 shadow-xl text-center pointer-events-none transition-all duration-200">
